# Copy to backend/.env and fill in. `.env` is git-ignored; this file is not.
#
# Nothing loads .env automatically — export these in your shell, or use your
# runner's env-file support:
#     uvicorn app.main:app --reload --env-file .env

# Chat (M2). Leave blank and /chat still works: it returns recommendations from
# the saved profile with `degraded: "LLM_UNAVAILABLE"` instead of a written reply.
GEMINI_API_KEY=

# Pinned so a renamed model is a deliberate change, not a surprise outage.
GEMINI_EXTRACT_MODEL=gemini-2.5-flash
GEMINI_NARRATE_MODEL=gemini-2.5-flash
# Gemini rejects a deadline under 10s, so 10000 is the practical floor.
GEMINI_TIMEOUT_MS=15000
